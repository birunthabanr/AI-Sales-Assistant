{
  "compilerOptions": {
    "target": "ES2020",
    "useDefineForClassFields": true,
    "lib": ["ES2020", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "skipLibCheck": true,

    /* Bundler mode */
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "isolatedModules": true,
    "moduleDetection": "force",
    "noEmit": true,
    "jsx": "react-jsx",

    /* Linting */
    "strict": false,
    "noUnusedLocals": false,
    "noUnusedParameters": false,
    "noImplicitAny": false,
    "noFallthroughCasesInSwitch": false,

    "paths": {
      "@/*": ["./src/*"]
    }
  },
  "include": ["src", "cypress/component/AnimationBackgroundAnimatedBackground.cy.tsx", "cypress/component/leftchatbarSidebar.cy.tsx", "cypress/component/Navigation.cy.tsx", "cypress/pages/Chat.cy.tsx", "cypress/pages/DashboardDashboardPage.cy.tsx", "cypress/pages/Index.cy.tsx", "cypress/pages/Profile.cy.tsx"]
}
